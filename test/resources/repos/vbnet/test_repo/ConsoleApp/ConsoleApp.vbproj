<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ConsoleApp</RootNamespace>
  </PropertyGroup>

  <!-- Only the C# library is referenced here; the C# -> VB.NET direction is covered by the
       Consumer project. Both directions are expected to resolve. -->
  <ItemGroup>
    <ProjectReference Include="..\CoreLib\CoreLib.csproj" />
  </ItemGroup>

</Project>
