<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Intentionally empty: a VB.NET SDK-style project defaults RootNamespace to the project
         name, and that default is prepended to every explicit `Namespace X ... End Namespace`
         block in the sources. Leaving it set would silently compile the types into
         TestProject.TestProject.* instead of the declared TestProject.*. -->
    <RootNamespace></RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- This project sits at the root of the test repository, so the default glob would
       otherwise pull in the source files of the projects nested below it. -->
  <ItemGroup>
    <Compile Remove="ConsoleApp\**" />
    <Compile Remove="CoreLib\**" />
    <Compile Remove="Consumer\**" />
  </ItemGroup>

</Project>
